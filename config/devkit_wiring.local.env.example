# Local DevKit breadboard wiring overrides for `esp32-s3-devkitc-1-n32r16`.
#
# Usage:
# 1. Copy to `config/devkit_wiring.local.env`
# 2. Set the GPIOs that match your actual harness
# 3. Run `./scripts/run_app.sh ...`
#
# This file is intentionally compile-time input for the ESP firmware build.

# Temporary DevKit breadboard baseline used for bench bring-up.
#
# This example keeps the onboard LED on GPIO38 and moves the temporary DRV
# harness to a non-conflicting map. Encoder A/B pins here are only a test
# harness suggestion; for DevKit probing they can be moved to any free GPIOs
# using the same OWB_DEVKIT_ENC* variables.
#
# Shared motor driver enable / sleep.
export OWB_DEVKIT_MTR_SLEEP=45

# Motor 1
export OWB_DEVKIT_MTR1_PHASE=2
export OWB_DEVKIT_MTR1_DRIVE=46

# Motor 2
export OWB_DEVKIT_MTR2_PHASE=13
export OWB_DEVKIT_MTR2_DRIVE=21

# Motor 3
export OWB_DEVKIT_MTR3_PHASE=47
export OWB_DEVKIT_MTR3_DRIVE=48

# Quadrature encoders
export OWB_DEVKIT_ENC1_A=39
export OWB_DEVKIT_ENC1_B=40
export OWB_DEVKIT_ENC2_A=41
export OWB_DEVKIT_ENC2_B=42
export OWB_DEVKIT_ENC3_A=4
export OWB_DEVKIT_ENC3_B=5

# Optional addressable LED pin for bench bring-up.
# Newer DevKitC-1 boards often use GPIO38; older boards may use GPIO48.
export OWB_DEVKIT_LED_PIN=38
