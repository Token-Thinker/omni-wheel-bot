# Confirmed DevKit bench smoke-test preset.
#
# Purpose:
# - keep the onboard LED alive on GPIO38
# - drive one or more DRV8874 bridges from a non-conflicting temporary map
# - use Encoder 1 on GPIO39/GPIO40 as a known-working reference
#
# Notes:
# - This is a test harness preset, not a final PCB pin assignment.
# - For bench work, encoder A/B can be moved to any free GPIOs.
# - Copy the values you want into `config/devkit_wiring.local.env`.

export OWB_DEVKIT_MTR_SLEEP=45

export OWB_DEVKIT_MTR1_PHASE=2
export OWB_DEVKIT_MTR1_DRIVE=46

export OWB_DEVKIT_MTR2_PHASE=13
export OWB_DEVKIT_MTR2_DRIVE=21

export OWB_DEVKIT_MTR3_PHASE=47
export OWB_DEVKIT_MTR3_DRIVE=48

# Confirmed working encoder reference
export OWB_DEVKIT_ENC1_A=39
export OWB_DEVKIT_ENC1_B=40

# Spare test suggestions; move as needed
export OWB_DEVKIT_ENC2_A=41
export OWB_DEVKIT_ENC2_B=42
export OWB_DEVKIT_ENC3_A=4
export OWB_DEVKIT_ENC3_B=5

# Newer DevKitC-1 boards often use GPIO38; older boards may use GPIO48.
export OWB_DEVKIT_LED_PIN=38
